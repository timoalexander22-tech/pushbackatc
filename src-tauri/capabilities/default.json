{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Virtual Ground Crew window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:4173", "http://localhost:5173"]
  },
  "permissions": [
    "core:default",
    "allow-list-plugins",
    "allow-open-plugin-folder",
    "allow-write-app-log",
    "allow-backup-app-config",
    "allow-open-external-url",
    "allow-open-microphone-settings",
    "allow-check-latest-release",
    "allow-test-github-connection",
    "allow-download-installer",
    "allow-run-installer"
  ]
}
