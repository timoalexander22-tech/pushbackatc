{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Virtual Ground Crew window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list_plugins",
    "allow-open_plugin_folder",
    "allow-write_app_log",
    "allow-backup_app_config",
